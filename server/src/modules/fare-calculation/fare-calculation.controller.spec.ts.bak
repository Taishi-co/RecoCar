import { Test, TestingModule } from '@nestjs/testing'
import { BadRequestException } from '@nestjs/common'
import { FareCalculationController } from './fare-calculation.controller'
import { FareCalculationService, FareCalculationResult } from './fare-calculation.service'

describe('FareCalculationController', () => {
  let controller: FareCalculationController
  let service: FareCalculationService

  // Mock 数据
  const mockFareResult: FareCalculationResult = {
    vehicle_id: 'vehicle-001',
    vehicle_type: '小型货车',
    base_price: 200,
    base_distance: 10,
    price_per_km: 1.5,
    total_distance: 50,
    extra_distance: 40,
    extra_fare: 60,
    total_fare: 260,
    calculation_detail: {
      base_price: 200,
      base_distance: 10,
      price_per_km: 1.5,
      total_distance: 50,
      extra_distance: 40,
      extra_fare: 60,
      total_fare: 260
    },
    route_type: 'non_highway',
    is_estimate: false,
    route_duration: 1800
  }

  const mockFareResult2: FareCalculationResult = {
    vehicle_id: 'vehicle-002',
    vehicle_type: '中型货车',
    base_price: 300,
    base_distance: 10,
    price_per_km: 2,
    total_distance: 50,
    extra_distance: 40,
    extra_fare: 80,
    total_fare: 380,
    calculation_detail: {
      base_price: 300,
      base_distance: 10,
      price_per_km: 2,
      total_distance: 50,
      extra_distance: 40,
      extra_fare: 80,
      total_fare: 380
    },
    route_type: 'non_highway',
    is_estimate: false,
    route_duration: 1800
  }

  beforeEach(async () => {
    const mockService = {
      calculateFare: jest.fn(),
      calculateFareForMultipleVehicles: jest.fn(),
      validatePricing: jest.fn()
    }

    const module: TestingModule = await Test.createTestingModule({
      controllers: [FareCalculationController],
      providers: [
        {
          provide: FareCalculationService,
          useValue: mockService
        }
      ]
    }).compile()

    controller = module.get<FareCalculationController>(FareCalculationController)
    service = module.get<FareCalculationService>(FareCalculationService)
  })

  afterEach(() => {
    jest.clearAllMocks()
  })

  describe('calculateFare', () => {
    it('应该正确计算单辆车的运费', async () => {
      jest.spyOn(service, 'calculateFare').mockResolvedValueOnce(mockFareResult)

      const result = await controller.calculateFare({
        vehicle_id: 'vehicle-001',
        total_distance: 50
      })

      expect(result).toEqual({
        code: 200,
        message: '计算成功',
        data: mockFareResult
      })

      expect(service.calculateFare).toHaveBeenCalledWith('vehicle-001', 50)
    })

    it('应该在车辆 ID 不存在时返回错误', async () => {
      jest
        .spyOn(service, 'calculateFare')
        .mockRejectedValueOnce(new BadRequestException('车辆不存在或定价信息不完整'))

      await expect(
        controller.calculateFare({
          vehicle_id: 'invalid-id',
          total_distance: 50
        })
      ).rejects.toThrow(new BadRequestException('车辆不存在或定价信息不完整'))
    })

    it('应该在缺少必填参数时正常工作（由 Service 层验证）', async () => {
      // Controller 层不做参数验证，由 Service 层处理
      jest.spyOn(service, 'calculateFare').mockRejectedValueOnce(
        new BadRequestException('请提供完整的参数')
      )

      await expect(
        controller.calculateFare({
          vehicle_id: '',
          total_distance: 50
        })
      ).rejects.toThrow(new BadRequestException('请提供完整的参数'))
    })
  })

  describe('calculateFareForMultipleVehicles', () => {
    it('应该正确计算多辆车的运费和价格区间', async () => {
      jest
        .spyOn(service, 'calculateFareForMultipleVehicles')
        .mockResolvedValueOnce([mockFareResult, mockFareResult2])

      const result = await controller.calculateFareForMultipleVehicles({
        vehicle_ids: ['vehicle-001', 'vehicle-002'],
        pickup_lat: 39.9,
        pickup_lng: 116.4,
        delivery_lat: 31.2,
        delivery_lng: 121.5
      })

      expect(result).toEqual({
        code: 200,
        message: '计算成功',
        data: {
          vehicles: [mockFareResult, mockFareResult2],
          route_info: {
            route_type: 'non_highway',
            is_estimate: false,
            route_duration: 1800
          },
          fare_range: {
            min: 260,
            max: 380,
            text: '¥260.00 - ¥380.00'
          }
        }
      })

      expect(service.calculateFareForMultipleVehicles).toHaveBeenCalledWith(
        ['vehicle-001', 'vehicle-002'],
        39.9,
        116.4,
        31.2,
        121.5
      )
    })

    it('应该返回估算路线信息', async () => {
      const estimateResult = {
        ...mockFareResult,
        route_type: 'estimated' as const,
        is_estimate: true,
        route_duration: 200
      }

      jest.spyOn(service, 'calculateFareForMultipleVehicles').mockResolvedValueOnce([estimateResult])

      const result = await controller.calculateFareForMultipleVehicles({
        vehicle_ids: ['vehicle-001'],
        pickup_lat: 39.9,
        pickup_lng: 116.4,
        delivery_lat: 31.2,
        delivery_lng: 121.5
      })

      expect(result.data.route_info).toEqual({
        route_type: 'estimated',
        is_estimate: true,
        route_duration: 200
      })
    })

    it('应该在所有车辆计算失败时返回错误', async () => {
      jest
        .spyOn(service, 'calculateFareForMultipleVehicles')
        .mockRejectedValueOnce(new BadRequestException('所有车辆运费计算失败'))

      await expect(
        controller.calculateFareForMultipleVehicles({
          vehicle_ids: ['invalid-1', 'invalid-2'],
          pickup_lat: 39.9,
          pickup_lng: 116.4,
          delivery_lat: 31.2,
          delivery_lng: 121.5
        })
      ).rejects.toThrow(new BadRequestException('所有车辆运费计算失败'))
    })

    it('应该在距离计算失败时返回错误', async () => {
      jest
        .spyOn(service, 'calculateFareForMultipleVehicles')
        .mockRejectedValueOnce(new BadRequestException('距离计算失败，请稍后重试'))

      await expect(
        controller.calculateFareForMultipleVehicles({
          vehicle_ids: ['vehicle-001'],
          pickup_lat: 39.9,
          pickup_lng: 116.4,
          delivery_lat: 31.2,
          delivery_lng: 121.5
        })
      ).rejects.toThrow(new BadRequestException('距离计算失败，请稍后重试'))
    })

    it('应该在缺少必填参数时正常工作（由 Service 层验证）', async () => {
      jest
        .spyOn(service, 'calculateFareForMultipleVehicles')
        .mockRejectedValueOnce(new BadRequestException('请提供完整的经纬度坐标'))

      await expect(
        controller.calculateFareForMultipleVehicles({
          vehicle_ids: ['vehicle-001'],
          pickup_lat: 0,
          pickup_lng: 0,
          delivery_lat: 0,
          delivery_lng: 0
        })
      ).rejects.toThrow(new BadRequestException('请提供完整的经纬度坐标'))
    })
  })

  describe('validatePricing', () => {
    it('应该验证通过合理的定价参数', async () => {
      const mockValidation = { valid: true, errors: [] }
      jest.spyOn(service, 'validatePricing').mockReturnValueOnce(mockValidation)

      const result = await controller.validatePricing({
        base_price: 200,
        base_distance: 10,
        price_per_km: 1.5
      })

      expect(result).toEqual({
        code: 200,
        message: '定价参数合理',
        data: mockValidation
      })

      expect(service.validatePricing).toHaveBeenCalledWith({
        base_price: 200,
        base_distance: 10,
        price_per_km: 1.5
      })
    })

    it('应该在定价参数不合理时返回错误信息', async () => {
      const mockValidation = {
        valid: false,
        errors: ['起步价必须在 10-500 元之间', '起步公里数必须在 1-10 公里之间']
      }
      jest.spyOn(service, 'validatePricing').mockReturnValueOnce(mockValidation)

      const result = await controller.validatePricing({
        base_price: 5,
        base_distance: 15,
        price_per_km: 1.5
      })

      expect(result).toEqual({
        code: 200,
        message: '定价参数不合理',
        data: mockValidation
      })

      expect(service.validatePricing).toHaveBeenCalledWith({
        base_price: 5,
        base_distance: 15,
        price_per_km: 1.5
      })
    })

    it('应该在多个错误时返回所有错误信息', async () => {
      const mockValidation = {
        valid: false,
        errors: [
          '起步价必须在 10-500 元之间',
          '起步公里数必须在 1-10 公里之间',
          '每公里运价必须在 0.5-20 元之间'
        ]
      }
      jest.spyOn(service, 'validatePricing').mockReturnValueOnce(mockValidation)

      const result = await controller.validatePricing({
        base_price: 5,
        base_distance: 15,
        price_per_km: 0.3
      })

      expect(result.data.errors).toHaveLength(3)
    })
  })
})
