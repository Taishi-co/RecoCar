import { Test, TestingModule } from '@nestjs/testing'
import { BadRequestException } from '@nestjs/common'
import { FareCalculationService } from './fare-calculation.service'
import { DemandsService } from '../demands/demands.service'

describe('FareCalculationService', () => {
  let service: FareCalculationService
  let demandsService: DemandsService
  let mockSupabase: any

  // Mock 数据
  const mockVehicle = {
    id: 'vehicle-001',
    vehicle_type: '小型货车',
    base_price: '200',
    base_distance: '10',
    price_per_km: '1.5'
  }

  const mockDistanceResult = {
    code: 200,
    data: {
      distance: 50,
      distance_text: '50.00公里',
      estimated_fare: 50,
      route_type: 'non_highway',
      route_duration: 1800, // 30分钟
      duration_text: '约30分钟',
      polyline: [],
      is_estimate: false
    }
  }

  const mockDistanceResultEstimate = {
    code: 200,
    data: {
      distance: 75, // 直线距离 50 * 1.5
      distance_text: '75.00公里',
      estimated_fare: 75,
      route_type: 'estimated',
      route_duration: 200, // 估算时长
      duration_text: '约3分钟',
      polyline: [],
      is_estimate: true
    }
  }

  beforeEach(async () => {
    // Mock Supabase 客户端
    mockSupabase = {
      from: jest.fn().mockReturnThis(),
      select: jest.fn().mockReturnThis(),
      eq: jest.fn().mockReturnThis(),
      maybeSingle: jest.fn()
    }

    // Mock DemandsService
    const mockDemandsService = {
      calculateDistance: jest.fn()
    }

    const module: TestingModule = await Test.createTestingModule({
      providers: [
        FareCalculationService,
        {
          provide: DemandsService,
          useValue: mockDemandsService
        }
      ]
    }).compile()

    service = module.get<FareCalculationService>(FareCalculationService)
    demandsService = module.get<DemandsService>(DemandsService)

    // 覆盖 Supabase 客户端
    ;(service as any).supabase = mockSupabase
  })

  afterEach(() => {
    jest.clearAllMocks()
  })

  describe('calculateFare', () => {
    it('应该正确计算运费（距离 > 起步公里数）', async () => {
      // 准备测试数据
      mockSupabase.maybeSingle.mockResolvedValueOnce({ data: mockVehicle, error: null })

      // 执行测试
      const result = await service.calculateFare('vehicle-001', 50)

      // 验证结果
      expect(result).toEqual({
        vehicle_id: 'vehicle-001',
        vehicle_type: '小型货车',
        base_price: 200,
        base_distance: 10,
        price_per_km: 1.5,
        total_distance: 50,
        extra_distance: 40,
        extra_fare: 60,
        total_fare: 260,
        calculation_detail: {
          base_price: 200,
          base_distance: 10,
          price_per_km: 1.5,
          total_distance: 50,
          extra_distance: 40,
          extra_fare: 60,
          total_fare: 260
        },
        route_type: 'non_highway',
        is_estimate: false
      })
    })

    it('应该正确计算运费（距离 = 起步公里数，额外距离为 0）', async () => {
      mockSupabase.maybeSingle.mockResolvedValueOnce({ data: mockVehicle, error: null })

      const result = await service.calculateFare('vehicle-001', 10)

      expect(result.extra_distance).toBe(0)
      expect(result.extra_fare).toBe(0)
      expect(result.total_fare).toBe(200)
    })

    it('应该正确计算运费（距离 < 起步公里数，额外距离为 0）', async () => {
      mockSupabase.maybeSingle.mockResolvedValueOnce({ data: mockVehicle, error: null })

      const result = await service.calculateFare('vehicle-001', 5)

      expect(result.extra_distance).toBe(0)
      expect(result.extra_fare).toBe(0)
      expect(result.total_fare).toBe(200)
    })

    it('应该正确计算长距离运费', async () => {
      mockSupabase.maybeSingle.mockResolvedValueOnce({ data: mockVehicle, error: null })

      const result = await service.calculateFare('vehicle-001', 200)

      expect(result.extra_distance).toBe(190)
      expect(result.extra_fare).toBe(285)
      expect(result.total_fare).toBe(485)
    })

    it('应该在车辆不存在时抛出异常', async () => {
      mockSupabase.maybeSingle.mockResolvedValueOnce({ data: null, error: null })

      await expect(service.calculateFare('invalid-id', 50)).rejects.toThrow(
        new BadRequestException('车辆不存在或定价信息不完整')
      )
    })

    it('应该在车辆定价信息不完整时抛出异常', async () => {
      const invalidVehicle = {
        id: 'vehicle-002',
        vehicle_type: '小型货车',
        base_price: '200',
        base_distance: null, // 缺少起步公里数
        price_per_km: '1.5'
      }

      mockSupabase.maybeSingle.mockResolvedValueOnce({ data: invalidVehicle, error: null })

      await expect(service.calculateFare('vehicle-002', 50)).rejects.toThrow(
        new BadRequestException('车辆定价信息不完整，请先设置定价')
      )
    })

    it('应该在数据库查询出错时抛出异常', async () => {
      mockSupabase.maybeSingle.mockResolvedValueOnce({
        data: null,
        error: { message: 'Database connection failed' }
      })

      await expect(service.calculateFare('vehicle-001', 50)).rejects.toThrow(
        new BadRequestException('车辆不存在或定价信息不完整')
      )
    })
  })

  describe('calculateFareForMultipleVehicles', () => {
    beforeEach(() => {
      // Mock DemandsService 返回非估算距离
      ;(demandsService.calculateDistance as jest.Mock).mockResolvedValueOnce(mockDistanceResult)
    })

    it('应该正确计算多辆车的运费（使用高德 API）', async () => {
      mockSupabase.maybeSingle
        .mockResolvedValueOnce({ data: mockVehicle, error: null }) // 第一辆车
        .mockResolvedValueOnce({
          data: { ...mockVehicle, id: 'vehicle-002', vehicle_type: '中型货车' },
          error: null
        }) // 第二辆车

      const result = await service.calculateFareForMultipleVehicles(
        ['vehicle-001', 'vehicle-002'],
        39.9,
        116.4,
        31.2,
        121.5
      )

      expect(result).toHaveLength(2)
      expect(result[0].total_distance).toBe(50)
      expect(result[0].route_type).toBe('non_highway')
      expect(result[0].is_estimate).toBe(false)
      expect(result[0].route_duration).toBe(1800)

      // 验证调用了 DemandsService
      expect(demandsService.calculateDistance).toHaveBeenCalledWith({
        pickup_lat: 39.9,
        pickup_lng: 116.4,
        delivery_lat: 31.2,
        delivery_lng: 121.5
      })
    })

    it('应该正确使用降级方案（高德 API 返回估算值）', async () => {
      ;(demandsService.calculateDistance as jest.Mock).mockResolvedValueOnce(mockDistanceResultEstimate)

      mockSupabase.maybeSingle.mockResolvedValueOnce({ data: mockVehicle, error: null })

      const result = await service.calculateFareForMultipleVehicles(
        ['vehicle-001'],
        39.9,
        116.4,
        31.2,
        121.5
      )

      expect(result).toHaveLength(1)
      expect(result[0].total_distance).toBe(75)
      expect(result[0].route_type).toBe('estimated')
      expect(result[0].is_estimate).toBe(true)
    })

    it('应该跳过计算失败的车辆', async () => {
      mockSupabase.maybeSingle
        .mockResolvedValueOnce({ data: mockVehicle, error: null }) // 第一辆车成功
        .mockResolvedValueOnce({ data: null, error: null }) // 第二辆车失败

      const result = await service.calculateFareForMultipleVehicles(
        ['vehicle-001', 'vehicle-002'],
        39.9,
        116.4,
        31.2,
        121.5
      )

      expect(result).toHaveLength(1)
      expect(result[0].vehicle_id).toBe('vehicle-001')
    })

    it('应该在所有车辆计算失败时抛出异常', async () => {
      mockSupabase.maybeSingle.mockResolvedValue({ data: null, error: null })

      await expect(
        service.calculateFareForMultipleVehicles(['invalid-1', 'invalid-2'], 39.9, 116.4, 31.2, 121.5)
      ).rejects.toThrow(new BadRequestException('所有车辆运费计算失败'))
    })

    it('应该在距离计算失败时抛出异常', async () => {
      ;(demandsService.calculateDistance as jest.Mock).mockRejectedValueOnce(
        new Error('高德地图 API 调用失败')
      )

      await expect(
        service.calculateFareForMultipleVehicles(['vehicle-001'], 39.9, 116.4, 31.2, 121.5)
      ).rejects.toThrow(new BadRequestException('距离计算失败，请稍后重试'))
    })
  })

  describe('validatePricing', () => {
    it('应该验证通过合理的定价参数', () => {
      const result = service.validatePricing({
        base_price: 200,
        base_distance: 10,
        price_per_km: 1.5
      })

      expect(result.valid).toBe(true)
      expect(result.errors).toHaveLength(0)
    })

    it('应该在起步价过低时验证失败', () => {
      const result = service.validatePricing({
        base_price: 5,
        base_distance: 10,
        price_per_km: 1.5
      })

      expect(result.valid).toBe(false)
      expect(result.errors).toContain('起步价必须在 10-500 元之间')
    })

    it('应该在起步价过高时验证失败', () => {
      const result = service.validatePricing({
        base_price: 600,
        base_distance: 10,
        price_per_km: 1.5
      })

      expect(result.valid).toBe(false)
      expect(result.errors).toContain('起步价必须在 10-500 元之间')
    })

    it('应该在起步公里数过低时验证失败', () => {
      const result = service.validatePricing({
        base_price: 200,
        base_distance: 0.5,
        price_per_km: 1.5
      })

      expect(result.valid).toBe(false)
      expect(result.errors).toContain('起步公里数必须在 1-10 公里之间')
    })

    it('应该在起步公里数过高时验证失败', () => {
      const result = service.validatePricing({
        base_price: 200,
        base_distance: 15,
        price_per_km: 1.5
      })

      expect(result.valid).toBe(false)
      expect(result.errors).toContain('起步公里数必须在 1-10 公里之间')
    })

    it('应该在每公里运价过低时验证失败', () => {
      const result = service.validatePricing({
        base_price: 200,
        base_distance: 10,
        price_per_km: 0.3
      })

      expect(result.valid).toBe(false)
      expect(result.errors).toContain('每公里运价必须在 0.5-20 元之间')
    })

    it('应该在每公里运价过高时验证失败', () => {
      const result = service.validatePricing({
        base_price: 200,
        base_distance: 10,
        price_per_km: 25
      })

      expect(result.valid).toBe(false)
      expect(result.errors).toContain('每公里运价必须在 0.5-20 元之间')
    })

    it('应该在起步价与起步公里数比例过高时验证失败', () => {
      const result = service.validatePricing({
        base_price: 400,
        base_distance: 1, // 单位起步价 400 元/公里 > 100 元/公里
        price_per_km: 1.5
      })

      expect(result.valid).toBe(false)
      expect(result.errors).toContain('起步价与起步公里数的比例过高，请调整定价')
    })

    it('应该在起步费过高时验证失败', () => {
      const result = service.validatePricing({
        base_price: 300,
        base_distance: 2, // 起步费 600 元 > 500 元
        price_per_km: 1.5
      })

      expect(result.valid).toBe(false)
      expect(result.errors).toContain('起步费过高，请调整定价')
    })

    it('应该返回多个错误信息', () => {
      const result = service.validatePricing({
        base_price: 5,
        base_distance: 15,
        price_per_km: 0.3
      })

      expect(result.valid).toBe(false)
      expect(result.errors.length).toBeGreaterThanOrEqual(3)
    })
  })
})
